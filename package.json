{
	"name": "freedom-party",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"postinstall": "prisma generate"
	},
	"devDependencies": {
		"@floating-ui/dom": "^1.4.5",
		"@skeletonlabs/skeleton": "^2.1.0",
		"@skeletonlabs/tw-plugin": "^0.2.0",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/forms": "^0.5.4",
		"@tailwindcss/typography": "^0.5.9",
		"@types/node": "^20.6.2",
		"@typescript-eslint/eslint-plugin": "^5.45.0",
		"@typescript-eslint/parser": "^5.45.0",
		"@vincjo/datatables": "^1.14.10",
		"autoprefixer": "^10.4.14",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^3.24.1",
		"highlight.js": "^11.8.0",
		"postcss": "^8.5.33",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.2.0",
		"prisma": "^5.16.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"sveltekit-sse": "^0.15.1",
		"tailwindcss": "^3.3.3",
		"tailwindcss-highlights": "^1.0.0",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.3.8"
	},
	"type": "module",
	"overrides": {
		"@sveltejs/kit": "$@sveltejs/kit",
		"typescript": "$typescript",
		"postcss-selector-parser": "^7.2.1",
		"glob": "^14.0.6",
		"minimatch": "^11.0.9"
	},
	"dependencies": {
		"@neoconfetti/svelte": "^1.0.0",
		"@prisma/client": "^5.8.0",
		"pm2": "^7.1.2",
		"svelte-confetti-explosion": "^0.4.0"
	}
}
